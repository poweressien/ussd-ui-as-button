{
  "name": "ussd-ui",
  "version": "0.1.0",
  "private": true,
  "description": "A visual button/form UI layer over carrier USSD services on Android — real TelephonyManager transport plus a full offline demo mode.",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.87.0",
    "zustand": "^5.0.15",
    "@react-native-async-storage/async-storage": "^3.1.1"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3",
    "ts-jest": "^29.4.12",
    "jest": "^29.7.0",
    "eslint": "^8.19.0",
    "prettier": "2.8.8"
  },
  "engines": {
    "node": ">=20"
  }
}
